@{
    Layout=null;
}
@model List<Feedback>
<h2 style="text-align:center;height:110px;line-height:100px;background-color:gray;">All Feedbacks</h2>
<table style="margin:70px auto;border:2px solid black;width:80%;text-align:center;">
    <thead>
        <tr>
            <th style="border:2px solid black;">ID</th>
            <th style="border:2px solid black;">Name</th>
            <th style="border:2px solid black;">Course</th>
            <th style="border:2px solid black;">Comments</th>
            <th style="border:2px solid black;">Rating</th>
            <th style="border:2px solid black;">Date of Submition</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var fb in Model){
            <tr>
                <td style="border:2px solid black;">@fb.Id</td>
                <td style="border:2px solid black;">@fb.StudentName</td>
                <td style="border:2px solid black;">@fb.Course</td>
                <td style="border:2px solid black;">@fb.Comments</td>
                <td style="border:2px solid black;">@fb.Rating</td>
                <td style="border:2px solid black;">@fb.DateSubmitted</td>
                
            </tr>
        }
    </tbody>
</table>
    <div style="text-align:center;margin-top:100px;">
    <a href="/Feedback/Index"><button type="button" style="font-size:20px;background-color:gray;">Go to Main Page</button></a>
    </div>